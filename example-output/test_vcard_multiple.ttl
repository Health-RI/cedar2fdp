@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix v: <http://www.w3.org/2006/vcard/ns#> .

<http://example.com> a dcat:Dataset ;
    dcterms:creator [ a v:VCard ;
            v:fn "Maria der Vries" ;
            v:hasUID <http://orcid.org/test_id1> ],
        [ a v:VCard ;
            v:fn "Jan der Vries" ;
            v:hasUID <http://orcid.org/test_id2> ] .

